# Port som servern lyssnar på
PORT=3000
# Sökväg till SQLite-databasen
DATABASE_PATH=./data/mysterysnus.db
# API-nyckel som webbshopen/integrationer skickar i headern X-API-Key
API_KEY=byt-ut-mig
# Första admin-kontot. Lämnas ADMIN_PASSWORD tomt används "admin123" (bara utanför produktion).
ADMIN_EMAIL=admin@mysterysnus.se
ADMIN_PASSWORD=
# Sätt till "production" i drift (kräver API_KEY och säkra cookies)
NODE_ENV=development

# --- Etiketter / transportörer ---
# manual = kollinummer skrivs in för hand. nshift / postnord kräver uppgifterna nedan.
LABEL_PROVIDER=manual
SENDER_NAME=Mysterysnus
SENDER_STREET=
SENDER_POSTAL_CODE=
SENDER_CITY=
SENDER_COUNTRY=SE
SENDER_PHONE=
SENDER_EMAIL=
# nShift (f.d. Unifaun)
NSHIFT_API_ID=
NSHIFT_API_SECRET=
NSHIFT_SENDER_ID=
# PostNord
POSTNORD_API_KEY=
POSTNORD_CUSTOMER_NUMBER=
