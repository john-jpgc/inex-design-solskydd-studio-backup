# Port som servern lyssnar på
PORT=3000
# Sökväg till SQLite-databasen
DATABASE_PATH=./data/mysterysnus.db
# API-nyckel som webbshopen/integrationer skickar i headern X-API-Key
API_KEY=byt-ut-mig
# Lösenord för det första admin-kontot (används av `npm run seed`)
ADMIN_EMAIL=admin@mysterysnus.se
ADMIN_PASSWORD=byt-ut-mig
# Sätt till "production" i drift (kräver API_KEY och säkra cookies)
NODE_ENV=development
